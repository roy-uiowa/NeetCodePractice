class Solution:
    def longestPalindrome(self, s: str) -> str:
        resultStr = ""
        resultLen = 0

        for i in range(len(s)):
            leftPtr, rightPtr = i, i
            while leftPtr >= 0 and rightPtr < len(s) and s[leftPtr] == s[rightPtr]:
                if rightPtr+1-leftPtr > resultLen:
                    resultStr = s[leftPtr:rightPtr+1]
                    resultLen = rightPtr+1-leftPtr
                leftPtr -= 1
                rightPtr += 1

            leftPtr, rightPtr = i, i+1
            while leftPtr >= 0 and rightPtr < len(s) and s[leftPtr] == s[rightPtr]:
                if rightPtr+1-leftPtr > resultLen:
                    resultStr = s[leftPtr:rightPtr+1]
                    resultLen = rightPtr+1-leftPtr
                leftPtr -= 1
                rightPtr += 1
            
            
        return resultStr
